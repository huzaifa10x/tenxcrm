diff --git a/app/Console/Commands/SendDailyTaskDigest.php b/app/Console/Commands/SendDailyTaskDigest.php
new file mode 100644
index 0000000..1d28cee
--- /dev/null
+++ b/app/Console/Commands/SendDailyTaskDigest.php
@@ -0,0 +1,98 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Mail\DailyTaskDigestMail;
+use App\Models\EmailReminderLog;
+use App\Models\User;
+use App\Support\ReminderSettings;
+use App\Support\TaskMailContext;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Mail;
+
+/**
+ * Daily "My Tasks" digest — one email per team member who has overdue,
+ * due-today or upcoming open tasks.
+ */
+class SendDailyTaskDigest extends Command
+{
+    protected $signature = 'tasks:send-daily-digest
+                            {--user= : Only send for this user ID}
+                            {--dry-run : List what would be sent without sending or logging}
+                            {--to= : Send to this address instead (test mode, nothing is logged)}';
+
+    protected $description = 'Send the daily "My Tasks" digest to each team member';
+
+    public function handle(): int
+    {
+        $today = now()->startOfDay();
+        $todayStr = $today->toDateString();
+        $upcomingUntil = $today->copy()->addDays((int) ReminderSettings::get('digest_upcoming_days'))->toDateString();
+        $max = (int) ReminderSettings::get('digest_max_items');
+        $digestDate = $today->format('l, d M Y');
+
+        $tasksByUser = TaskMailContext::openTasksQuery()
+            ->when($this->option('user'), fn ($q, $id) => $q->where('assigned_to', $id))
+            ->whereDate('due_date', '<=', $upcomingUntil)
+            ->with(['project.companies'])
+            ->orderByRaw("CASE priority WHEN 'Urgent' THEN 1 WHEN 'High' THEN 2 WHEN 'Medium' THEN 3 ELSE 4 END")
+            ->orderBy('due_date')
+            ->get()
+            ->groupBy('assigned_to');
+
+        $users = User::whereIn('id', $tasksByUser->keys())->get();
+        $sent = 0;
+
+        foreach ($users as $user) {
+            if (!$user->canReceiveEmail() || (!$this->option('to') && !$user->wantsEmail('daily_digest'))) {
+                continue;
+            }
+
+            $tasks = $tasksByUser[$user->id];
+            // due_date may come back as "Y-m-d" or "Y-m-d H:i:s" depending on the driver.
+            $day = fn ($t) => substr((string) $t->due_date, 0, 10);
+            $groups = [
+                'overdue'   => $tasks->filter(fn ($t) => $day($t) < $todayStr)->sortBy($day),
+                'due_today' => $tasks->filter(fn ($t) => $day($t) === $todayStr),
+                'upcoming'  => $tasks->filter(fn ($t) => $day($t) > $todayStr)->sortBy($day),
+            ];
+
+            $sections = [];
+            foreach ($groups as $key => $group) {
+                $sections[$key] = $group->take($max)->map(fn ($t) => TaskMailContext::row($t))->values()->all();
+                $sections[$key . '_count'] = $group->count();
+            }
+
+            if ($this->option('dry-run')) {
+                $this->line(sprintf('  %-28s %-32s overdue %d · today %d · upcoming %d', $user->name, $user->email, $sections['overdue_count'], $sections['due_today_count'], $sections['upcoming_count']));
+                $sent++;
+                continue;
+            }
+
+            if ($this->option('to')) {
+                Mail::to($this->option('to'))->send(new DailyTaskDigestMail($user, $sections, $digestDate));
+                $this->line("  digest for {$user->name} → {$this->option('to')} (test)");
+                $sent++;
+                continue;
+            }
+
+            if (!EmailReminderLog::claim('digest', 'user', $user->id, $todayStr, $user->id)) {
+                continue;
+            }
+
+            try {
+                Mail::to($user->email)->send(new DailyTaskDigestMail($user, $sections, $digestDate));
+                $sent++;
+            } catch (\Throwable $e) {
+                EmailReminderLog::release('digest', 'user', $user->id, $todayStr);
+                Log::error('Daily digest email failed', ['user' => $user->id, 'error' => $e->getMessage()]);
+                $this->error("  digest for {$user->email} failed: {$e->getMessage()}");
+            }
+        }
+
+        $this->info(($this->option('dry-run') ? '[dry run] ' : '') . "{$sent} digest(s) " . ($this->option('dry-run') ? 'would be sent.' : 'sent.'));
+
+        return self::SUCCESS;
+    }
+}
diff --git a/app/Console/Commands/SendRenewalReminders.php b/app/Console/Commands/SendRenewalReminders.php
new file mode 100644
index 0000000..96c1d58
--- /dev/null
+++ b/app/Console/Commands/SendRenewalReminders.php
@@ -0,0 +1,98 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Mail\RenewalReminderMail;
+use App\Models\EmailReminderLog;
+use App\Models\Project;
+use App\Models\User;
+use App\Support\ReminderSettings;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Mail;
+
+/**
+ * Daily: renewal reminders to the account manager(s) 60 and 30 days before
+ * the current contract ends. Each stage is sent once per renewal date.
+ */
+class SendRenewalReminders extends Command
+{
+    protected $signature = 'projects:send-renewal-reminders
+                            {--project= : Only process this project ID}
+                            {--stage= : Force a stage (60 or 30) — only with --to}
+                            {--dry-run : List what would be sent without sending or logging}
+                            {--to= : Send to this address instead (test mode, nothing is logged)}';
+
+    protected $description = 'Send 60-day and 30-day renewal reminders to account managers';
+
+    public function handle(): int
+    {
+        $windows = collect(ReminderSettings::get('renewal_windows'));
+        $forced = $this->option('to') && $this->option('stage') ? (int) $this->option('stage') : null;
+        $today = now()->startOfDay();
+        $sent = 0;
+
+        $projects = Project::whereNotIn('status', ReminderSettings::INACTIVE_PROJECT_STATUSES)
+            ->when($this->option('project'), fn ($q, $id) => $q->whereKey($id))
+            ->with('accountManagers')
+            ->get();
+
+        foreach ($projects as $project) {
+            $renewalDate = RenewalReminderMail::contract($project)['renewal_date'];
+            if (!$renewalDate) {
+                continue;
+            }
+
+            $daysLeft = (int) $today->diffInDays($renewalDate, false);
+            $stage = $forced ?? $windows->search(fn ($w) => $daysLeft >= (int) $w[0] && $daysLeft <= (int) $w[1]);
+
+            if ($stage === false || $stage === null) {
+                continue;
+            }
+            $stage = (int) $stage;
+
+            $ams = $project->accountManagers->filter(fn (User $u) => $u->canReceiveEmail());
+            if ($ams->isEmpty()) {
+                $this->warn("  #{$project->id} {$project->title}: renewal in {$daysLeft} days but no account manager with an email — skipped.");
+                continue;
+            }
+
+            if ($this->option('dry-run')) {
+                if (EmailReminderLog::wasSent("renewal_{$stage}", 'project', $project->id, $renewalDate->toDateString())) {
+                    continue;
+                }
+                $this->line(sprintf('  renewal_%-3d #%-5d %-40s %3d days → %s', $stage, $project->id, mb_strimwidth($project->title, 0, 40, '…'), $daysLeft, $ams->pluck('email')->implode(', ')));
+                $sent++;
+                continue;
+            }
+
+            if ($this->option('to')) {
+                Mail::to($this->option('to'))->send(new RenewalReminderMail($project, $stage, $ams->first()));
+                $this->line("  renewal_{$stage} #{$project->id} → {$this->option('to')} (test)");
+                $sent++;
+                continue;
+            }
+
+            if (!EmailReminderLog::claim("renewal_{$stage}", 'project', $project->id, $renewalDate->toDateString())) {
+                continue;
+            }
+
+            try {
+                // One personalised email per account manager ("Hi {name}").
+                foreach ($ams as $am) {
+                    Mail::to($am->email)->send(new RenewalReminderMail($project, $stage, $am));
+                    $sent++;
+                }
+                $this->line("  renewal_{$stage} #{$project->id} {$project->title} → " . $ams->pluck('email')->implode(', '));
+            } catch (\Throwable $e) {
+                EmailReminderLog::release("renewal_{$stage}", 'project', $project->id, $renewalDate->toDateString());
+                Log::error('Renewal reminder email failed', ['project' => $project->id, 'error' => $e->getMessage()]);
+                $this->error("  renewal #{$project->id} failed: {$e->getMessage()}");
+            }
+        }
+
+        $this->info(($this->option('dry-run') ? '[dry run] ' : '') . "{$sent} renewal email(s) " . ($this->option('dry-run') ? 'would be sent.' : 'sent.'));
+
+        return self::SUCCESS;
+    }
+}
diff --git a/app/Console/Commands/SendTaskDueReminders.php b/app/Console/Commands/SendTaskDueReminders.php
new file mode 100644
index 0000000..1c4ad0a
--- /dev/null
+++ b/app/Console/Commands/SendTaskDueReminders.php
@@ -0,0 +1,184 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Mail\TaskDueReminderMail;
+use App\Mail\TaskOverdueMail;
+use App\Models\EmailReminderLog;
+use App\Models\Task;
+use App\Models\User;
+use App\Support\ReminderSettings;
+use App\Support\TaskMailContext;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Mail;
+
+/**
+ * Hourly: 48h / 24h due-date reminders, overdue notices, and escalation to the lead.
+ * Each email is sent once per task per due date (tracked in email_reminder_logs).
+ */
+class SendTaskDueReminders extends Command
+{
+    protected $signature = 'tasks:send-due-reminders
+                            {--task= : Only process this task ID}
+                            {--dry-run : List what would be sent without sending or logging}
+                            {--to= : Send every email to this address instead (test mode, nothing is logged)}';
+
+    protected $description = 'Send 48h/24h due-date reminders, overdue notices and escalations';
+
+    private int $sent = 0;
+
+    public function handle(): int
+    {
+        $now = now();
+        $lookback = (int) ReminderSettings::get('overdue_lookback_days');
+        $hours = collect(ReminderSettings::get('reminder_hours'))->map(fn ($h) => (int) $h)->sortDesc()->values();
+
+        $tasks = TaskMailContext::openTasksQuery()
+            ->when($this->option('task'), fn ($q, $id) => $q->whereKey($id))
+            // Window: overdue within the lookback period, up to the furthest reminder ahead.
+            ->whereDate('due_date', '>=', $now->copy()->subDays($lookback + 1)->toDateString())
+            ->whereDate('due_date', '<=', $now->copy()->addHours($hours->first() + 24)->toDateString())
+            ->with(['assignedTo.managers', 'project.accountManagers', 'project.companies'])
+            ->orderBy('due_date')
+            ->get();
+
+        foreach ($tasks as $task) {
+            $assignee = $task->assignedTo;
+            $dueAt = TaskMailContext::dueAt($task);
+
+            if (!$assignee || !$assignee->canReceiveEmail() || !$dueAt) {
+                continue;
+            }
+
+            if ($now->lessThan($dueAt)) {
+                $this->handleUpcoming($task, $assignee, $dueAt, $hours->all());
+            } else {
+                $this->handleOverdue($task, $assignee, $dueAt);
+            }
+        }
+
+        $this->info(($this->option('dry-run') ? '[dry run] ' : '') . "{$this->sent} email(s) " . ($this->option('dry-run') ? 'would be sent' : 'sent') . " ({$tasks->count()} task(s) checked).");
+
+        return self::SUCCESS;
+    }
+
+    private function handleUpcoming(Task $task, User $assignee, $dueAt, array $hours): void
+    {
+        if (!$assignee->wantsEmail('due_reminders')) {
+            return;
+        }
+
+        // Pick the narrowest window we're in (e.g. 24h beats 48h); never send both.
+        $hoursLeft = now()->diffInMinutes($dueAt) / 60;
+        $window = collect($hours)->sort()->first(fn ($h) => $hoursLeft <= $h);
+
+        if ($window === null) {
+            return;
+        }
+
+        // The "task assigned" email already covered a task created inside this window.
+        if ($task->created_at && $task->created_at->greaterThan($dueAt->copy()->subHours($window))) {
+            return;
+        }
+
+        $this->deliver("due_{$window}h", $task, [$assignee->email], [], fn () => new TaskDueReminderMail($task, $window));
+    }
+
+    private function handleOverdue(Task $task, User $assignee, $dueAt): void
+    {
+        $daysOverdue = $dueAt->diffInHours(now()) / 24;
+        $threshold = (int) ReminderSettings::get('escalation_threshold_days');
+
+        $amEmails = TaskMailContext::accountManagers($task)
+            ->pluck('email')
+            ->reject(fn ($e) => strcasecmp($e, $assignee->email) === 0)
+            ->unique()->values()->all();
+
+        if ($daysOverdue < $threshold) {
+            $this->deliver('overdue', $task, [$assignee->email], $amEmails,
+                fn () => new TaskOverdueMail($task, false, null, !empty($amEmails)));
+
+            return;
+        }
+
+        // Past the threshold and still open: escalate once. If the plain overdue notice was
+        // never sent (e.g. first run after deploy), this escalated email replaces it.
+        $lead = $this->leadFor($assignee);
+        $cc = $amEmails;
+        if ($lead && strcasecmp($lead->email, $assignee->email) !== 0) {
+            $cc[] = $lead->email;
+        }
+
+        if ($this->deliver('overdue_escalated', $task, [$assignee->email], array_values(array_unique($cc)),
+            fn () => new TaskOverdueMail($task, true, $lead, !empty($amEmails)))) {
+            if (!$this->isTestRun() && !$this->option('dry-run')) {
+                EmailReminderLog::claim('overdue', 'task', $task->id, TaskMailContext::dueReference($task), $assignee->id);
+            }
+        }
+    }
+
+    private function leadFor(User $assignee): ?User
+    {
+        $lead = $assignee->managers->first(fn (User $u) => $u->canReceiveEmail() && $u->id !== $assignee->id);
+
+        if (!$lead && ($fallback = ReminderSettings::get('escalation_fallback_email'))) {
+            $lead = User::where('email', $fallback)->first();
+        }
+
+        return $lead;
+    }
+
+    /**
+     * Claim, then queue the email. Returns true if it was (or would be) sent.
+     */
+    private function deliver(string $kind, Task $task, array $to, array $cc, callable $makeMail): bool
+    {
+        $reference = TaskMailContext::dueReference($task);
+
+        if ($this->option('dry-run')) {
+            if (EmailReminderLog::wasSent($kind, 'task', $task->id, $reference)) {
+                return false;
+            }
+            $this->line(sprintf('  %-18s #%-6d %-45s → %s%s', $kind, $task->id, mb_strimwidth($task->title, 0, 45, '…'), implode(', ', $to), $cc ? ' (cc ' . implode(', ', $cc) . ')' : ''));
+            $this->sent++;
+
+            return true;
+        }
+
+        if ($this->isTestRun()) {
+            Mail::to($this->option('to'))->send($makeMail());
+            $this->line("  {$kind} #{$task->id} → {$this->option('to')} (test)");
+            $this->sent++;
+
+            return true;
+        }
+
+        if (!EmailReminderLog::claim($kind, 'task', $task->id, $reference, $task->assigned_to)) {
+            return false;
+        }
+
+        try {
+            $mail = Mail::to($to);
+            if ($cc) {
+                $mail->cc($cc);
+            }
+            $mail->send($makeMail());
+            $this->line("  {$kind} #{$task->id} → " . implode(', ', $to));
+            $this->sent++;
+
+            return true;
+        } catch (\Throwable $e) {
+            EmailReminderLog::release($kind, 'task', $task->id, $reference);
+            Log::error('Task reminder email failed', ['kind' => $kind, 'task' => $task->id, 'error' => $e->getMessage()]);
+            $this->error("  {$kind} #{$task->id} failed: {$e->getMessage()}");
+
+            return false;
+        }
+    }
+
+    private function isTestRun(): bool
+    {
+        return (bool) $this->option('to');
+    }
+}
