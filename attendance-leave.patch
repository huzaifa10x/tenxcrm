@@ -0,0 +1,300 @@
+/* ==========================================================================
+   Attendance & Leave — 10X One
+   Shared by attendance/*, leaves/* and settings. Uses the 10X tokens from 10x-theme.css.
+   ========================================================================== */
+
+.xa {
+    --xa-radius: 14px;
+    --xa-shadow: 0 1px 2px rgba(15, 20, 18, .04), 0 6px 18px rgba(15, 20, 18, .05);
+    color: var(--x-text, #1f2a24);
+    font-size: .9rem;
+}
+
+.xa *, .xa *::before, .xa *::after { box-sizing: border-box; }
+
+/* ---------- page header ---------- */
+.xa-head {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 14px;
+    margin-bottom: 18px;
+}
+.xa-head-title { display: flex; align-items: center; gap: 14px; min-width: 0; }
+.xa-title { font-size: 1.35rem !important; font-weight: 800; color: var(--x-dark, #0f1412); margin: 0 !important; line-height: 1.2; }
+.xa-sub { color: var(--x-muted, #66736b); font-size: .85rem; margin-top: 2px; }
+.xa-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
+
+/* ---------- tabs ---------- */
+.xa-tabs { display: flex; gap: 4px; flex-wrap: wrap; border-bottom: 1px solid var(--x-border, #e3e9e2); margin-bottom: 18px; }
+.xa-tab {
+    padding: 9px 14px; font-weight: 600; font-size: .86rem; color: var(--x-muted, #66736b);
+    border-bottom: 2px solid transparent; margin-bottom: -1px; text-decoration: none !important; white-space: nowrap;
+}
+.xa-tab:hover { color: var(--x-dark, #0f1412); }
+.xa-tab.active { color: var(--x-dark, #0f1412); border-bottom-color: var(--x-lime, #a9e324); }
+.xa-tab .xa-count { margin-left: 6px; }
+
+/* ---------- buttons ---------- */
+.xa-btn {
+    display: inline-flex; align-items: center; gap: 6px; border-radius: 9px; padding: 8px 14px;
+    font-weight: 600; font-size: .85rem; border: 1px solid var(--x-border, #e3e9e2); background: #fff;
+    color: var(--x-dark, #0f1412); cursor: pointer; text-decoration: none !important; line-height: 1.2; white-space: nowrap;
+    transition: background .15s, border-color .15s, box-shadow .15s;
+}
+.xa-btn:hover { background: #f7f9f5; border-color: #cfd8cd; color: var(--x-dark, #0f1412); }
+.xa-btn:focus-visible { outline: none; box-shadow: var(--x-focus); }
+.xa-btn-primary { background: var(--x-lime, #a9e324); border-color: var(--x-lime, #a9e324); color: var(--x-dark, #0f1412); }
+.xa-btn-primary:hover { background: var(--x-lime-hover, #9ad01c); border-color: var(--x-lime-hover, #9ad01c); }
+.xa-btn-dark { background: var(--x-dark, #0f1412); border-color: var(--x-dark, #0f1412); color: #fff; }
+.xa-btn-dark:hover { background: #232d27; color: #fff; }
