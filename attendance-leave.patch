diff --git a/app/Services/Attendance/AttendancePolicy.php b/app/Services/Attendance/AttendancePolicy.php
new file mode 100644
index 0000000..0d2db93
--- /dev/null
+++ b/app/Services/Attendance/AttendancePolicy.php
@@ -0,0 +1,173 @@
+<?php
+
+namespace App\Services\Attendance;
+
+use App\Models\Attendance;
+use App\Models\GeneralSetting;
+use Carbon\Carbon;
+use Carbon\CarbonInterface;
+
+/**
+ * Company attendance rules, read from the existing general_settings row with safe defaults.
+ * All times are in the app timezone (Asia/Dubai).
+ */
+class AttendancePolicy
+{
+    public string $open;            // H:i:s
+
+    public string $close;           // H:i:s
+
+    public int $graceMinutes;       // late after open + grace
+
+    public string $halfDayAfter;    // punch-in after this = half day
+
+    public string $earlyOutBefore;  // punch-out before this = early out
+
+    public int $earlyPunchInMinutes;
+
+    public array $workingDays;      // ISO weekdays 1..7
+
+    public array $holidays;         // Y-m-d strings
+
+    public bool $configured;
+
+    private static ?self $cached = null;
+
+    public function __construct(?GeneralSetting $s)
+    {
+        $this->configured = (bool) $s;
+        $this->open = self::time($s->office_open_time ?? null, '09:00:00');
+        $this->close = self::time($s->office_close_time ?? null, '18:00:00');
+        $this->graceMinutes = (int) ($s->late_threshold ?? 15);
+        $this->halfDayAfter = self::time($s->half_day_threshold ?? null, '12:00:00');
+        $this->earlyOutBefore = self::time($s->early_out_threshold ?? null, $this->close);
+        $this->earlyPunchInMinutes = (int) ($s->early_punch_in_minutes ?? 15);
+        $days = array_values(array_filter(array_map('intval', (array) ($s->working_days ?? [])), fn ($d) => $d >= 1 && $d <= 7));
+        $this->workingDays = $days ?: [1, 2, 3, 4, 5];
+        $this->holidays = array_values(array_filter(array_map(fn ($d) => trim((string) $d, " \"'[]"), (array) ($s->holidays ?? []))));
+    }
+
+    public static function current(): self
+    {
+        return self::$cached ??= new self(GeneralSetting::first());
+    }
+
+    /** Forget the cached copy (after settings change, and between tests). */
+    public static function refresh(): self
+    {
+        self::$cached = null;
+
+        return self::current();
+    }
+
+    private static function time(?string $value, string $default): string
+    {
+        return $value ? Carbon::parse($value)->format('H:i:s') : $default;
+    }
+
+    public function at(CarbonInterface|string $date, string $time): Carbon
+    {
+        return Carbon::parse(Carbon::parse($date)->toDateString().' '.$time);
+    }
+
+    public function isHoliday(CarbonInterface|string $date): bool
+    {
+        return in_array(Carbon::parse($date)->toDateString(), $this->holidays, true);
+    }
+
+    public function isWeekend(CarbonInterface|string $date): bool
+    {
+        return ! in_array(Carbon::parse($date)->dayOfWeekIso, $this->workingDays, true);
+    }
+
+    public function isWorkingDay(CarbonInterface|string $date): bool
+    {
+        return ! $this->isWeekend($date) && ! $this->isHoliday($date);
+    }
+
+    public function lateThreshold(CarbonInterface|string $date): Carbon
+    {
+        return $this->at($date, $this->open)->addMinutes($this->graceMinutes);
+    }
+
+    /**
+     * Until this moment on $day, the PREVIOUS day's open record can still be punched out
+     * (overnight work). On working days that's when today's punch-in window opens; on other
+     * days it's noon.
+     */
+    public function overnightCutoff(CarbonInterface|string $day): Carbon
+    {
+        return $this->isWorkingDay($day)
+            ? $this->at($day, $this->open)->subMinutes($this->earlyPunchInMinutes)
+            : $this->at($day, '12:00:00');
+    }
+
+    /** Status for a punch-in at $at, using the same rules as before. */
+    public function statusForPunchIn(Carbon $at): string
+    {
+        if ($at->gt($this->at($at, $this->halfDayAfter))) {
+            return 'half_day';
+        }
+
+        return $at->gt($this->lateThreshold($at)) ? 'late' : 'present';
+    }
+
+    /** Minutes after office opening, when the punch-in was past the grace period. */
+    public function lateMinutes(Attendance $a): int
+    {
+        if (! $a->punch_in) {
+            return 0;
+        }
+        $in = $this->at($a->dateString(), $a->punch_in);
+
+        return $in->gt($this->lateThreshold($in)) ? (int) $this->at($in, $this->open)->diffInMinutes($in) : 0;
+    }
+
+    /** Minutes before the early-out threshold, for a real (not auto-closed) punch-out. */
+    public function earlyOutMinutes(Attendance $a): int
+    {
+        if (! $a->punch_out || $a->auto_closed) {
+            return 0;
+        }
+        $out = $this->at($a->dateString(), $a->punch_out);
+        if ($a->punch_in && $out->lt($this->at($a->dateString(), $a->punch_in))) {
+            return 0; // punched out after midnight
+        }
+        $limit = $this->at($a->dateString(), $this->earlyOutBefore);
+
+        return $out->lt($limit) ? (int) $out->diffInMinutes($limit) : 0;
+    }
+
+    /** Worked minutes from total_hours, or from the punch times. */
+    public function workedMinutes(Attendance $a): ?int
+    {
+        if (! $a->punch_in || ! $a->punch_out) {
+            return null;
+        }
+        if ($a->total_hours && preg_match('/^(\d+):(\d+)(?::(\d+))?$/', $a->total_hours, $m)) {
+            return (int) $m[1] * 60 + (int) $m[2];
+        }
+        $in = $this->at($a->dateString(), $a->punch_in);
+        $out = $this->at($a->dateString(), $a->punch_out);
+        if ($out->lt($in)) {
+            $out->addDay();
+        }
+
+        return (int) $in->diffInMinutes($out);
+    }
+
+    /** Scheduled working minutes per day (office open → close). */
+    public function scheduledMinutes(): int
+    {
+        return (int) Carbon::parse($this->open)->diffInMinutes(Carbon::parse($this->close));
+    }
+
+    public static function formatMinutes(?int $minutes): string
+    {
+        if ($minutes === null) {
+            return '—';
+        }
+
+        return intdiv($minutes, 60).'h '.str_pad((string) ($minutes % 60), 2, '0', STR_PAD_LEFT).'m';
+    }
+}
diff --git a/app/Services/Attendance/AttendanceReport.php b/app/Services/Attendance/AttendanceReport.php
new file mode 100644
index 0000000..d65f0a7
--- /dev/null
+++ b/app/Services/Attendance/AttendanceReport.php
@@ -0,0 +1,250 @@
+<?php
+
+namespace App\Services\Attendance;
+
+use App\Models\Attendance;
+use App\Models\LeaveRequest;
+use Carbon\Carbon;
+use Carbon\CarbonPeriod;
+use Illuminate\Support\Collection;
+
+/**
+ * Attendance numbers for a set of employees over a date range, computed from the actual
+ * records and the company policy (working days, holidays, office hours, grace period).
+ *
+ * Definitions
+ *  - Working day: a configured working weekday that is not a public holiday.
+ *  - Elapsed working days: working days before today, plus today once the person has punched in.
+ *  - Present: a working day with a punch-in (half-days included).
+ *  - Absent: an elapsed working day with no punch-in and no approved leave.
+ *  - Leave: a working day covered by approved leave (or a record marked "leave").
+ *  - Late: punched in after opening + grace (half-days counted separately).
+ *  - Missed punch-out: punched in but never punched out (auto-closed, or still open from a past day).
+ *  - Attendance % = (present − ½ × half-days) ÷ (elapsed working days − leave days).
+ */
+class AttendanceReport
+{
+    public function __construct(private ?AttendancePolicy $policy = null)
+    {
+        $this->policy ??= AttendancePolicy::current();
+    }
+
+    /**
+     * @param  Collection<int,\App\Models\User>  $users
+     * @return array{rows: Collection, totals: array, trend: array, from: string, to: string}
+     */
+    public function build(Collection $users, Carbon $from, Carbon $to): array
+    {
+        $from = $from->copy()->startOfDay();
+        $to = $to->copy()->startOfDay();
+        $ids = $users->pluck('id')->all();
+
+        $records = Attendance::whereIn('user_id', $ids)
+            ->whereBetween('date', [$from->toDateString(), $to->toDateString()])
+            ->withCount('notes')
+            ->orderBy('id')
+            ->get()
+            ->groupBy('user_id')
+            ->map(fn ($rows) => $rows->keyBy(fn ($r) => $r->dateString()));
+
+        $leaves = LeaveRequest::whereIn('user_id', $ids)
+            ->where('status', 'approved')
+            ->overlapping($from->toDateString(), $to->toDateString())
+            ->with('type:id,name,color')
+            ->get()
+            ->groupBy('user_id');
+
+        $rows = $users->map(fn ($u) => $this->forUser($u, $records->get($u->id, collect()), $leaves->get($u->id, collect()), $from, $to))->values();
+
+        return [
+            'rows' => $rows,
+            'totals' => $this->totals($rows, $from, $to),
+            'trend' => $this->trend($rows, $from, $to),
+            'from' => $from->toDateString(),
+            'to' => $to->toDateString(),
+        ];
+    }
+
+    /** Per-person summary plus day-by-day rows. */
+    public function forUser($user, Collection $records, Collection $leaves, Carbon $from, Carbon $to): array
+    {
+        $p = $this->policy;
+        $today = Carbon::today()->toDateString();
+        // Records from this date on may still be open (overnight work until noon next day).
+        $openFrom = Carbon::now()->lt($p->overnightCutoff(Carbon::today())) ? Carbon::yesterday()->toDateString() : $today;
+        $joined = $user->created_at ? Carbon::parse($user->created_at)->toDateString() : null;
+
+        $s = [
+            'working_days' => 0, 'elapsed_days' => 0, 'present' => 0, 'absent' => 0, 'late' => 0,
+            'late_minutes' => 0, 'half_days' => 0, 'early_outs' => 0, 'early_minutes' => 0,
+            'missed_punch_outs' => 0, 'leave_days' => 0, 'holidays' => 0, 'worked_minutes' => 0, 'worked_days' => 0,
+        ];
+        $days = [];
+
+        foreach (CarbonPeriod::create($from, $to) as $day) {
+            $date = $day->toDateString();
+            $rec = $records->get($date);
+            $leave = $leaves->first(fn ($l) => $l->start_date->toDateString() <= $date && $l->end_date->toDateString() >= $date);
+            $isWorking = $p->isWorkingDay($day);
+            $beforeJoin = $joined && $date < $joined;
+
+            $row = [
+                'date' => $date,
+                'id' => $rec?->id,
+                'punch_in' => $rec?->punch_in,
+                'punch_out' => $rec?->punch_out,
+                'worked' => null,
+                'late_minutes' => 0,
+                'early_minutes' => 0,
+                'missed_out' => false,
+                'auto_closed' => (bool) $rec?->auto_closed,
+                'edited' => (bool) $rec?->edited_at,
+                'notes' => (int) ($rec->notes_count ?? 0),
+                'leave' => $leave ? $leave->type?->name : null,
+                'location' => $rec?->location,
+                'raw_status' => $rec?->status,
+            ];
+
+            if ($rec && $rec->punch_in) {
+                $late = $p->lateMinutes($rec);
+                $isHalf = $rec->status === 'half_day';
+                $row['late_minutes'] = $late;
+                $row['early_minutes'] = $p->earlyOutMinutes($rec);
+                $row['worked'] = $p->workedMinutes($rec);
+                $stillOpen = ! $rec->punch_out && $date >= $openFrom;
+                $row['missed_out'] = $rec->auto_closed || (! $rec->punch_out && ! $stillOpen);
+                $row['status'] = $rec->status === 'early_out' && $late > 0 ? 'late' : ($rec->status ?: 'present');
+                if ($stillOpen) {
+                    $row['status'] = 'working';
+                }
+
+                // Worked time counts on any day (incl. weekend work), but not auto-closed guesses.
+                if ($row['worked'] !== null && ! $row['missed_out']) {
+                    $s['worked_minutes'] += $row['worked'];
+                    $s['worked_days']++;
+                }
+                if ($isWorking) {
+                    $s['present']++;
+                    $s['half_days'] += $isHalf ? 1 : 0;
+                    if (! $isHalf && ($rec->status === 'late' || $late > 0)) {
+                        $s['late']++;
+                        $s['late_minutes'] += $late;
+                    }
+                    if ($row['early_minutes'] > 0) {
+                        $s['early_outs']++;
+                        $s['early_minutes'] += $row['early_minutes'];
+                    }
+                    $s['missed_punch_outs'] += $row['missed_out'] ? 1 : 0;
+                }
+            } elseif (! $isWorking) {
+                $row['status'] = $p->isHoliday($day) ? 'holiday' : 'weekend';
+            } elseif ($beforeJoin) {
+                $row['status'] = 'not_joined';
+            } elseif ($leave || $rec?->status === 'leave') {
+                $row['status'] = 'leave';
+            } elseif ($date > $today) {
+                $row['status'] = 'upcoming';
+            } elseif ($date === $today) {
+                $row['status'] = 'pending';
+            } else {
+                $row['status'] = 'absent';
+            }
+
+            if ($isWorking && ! $beforeJoin) {
+                $s['working_days']++;
+                if ($row['status'] === 'leave') {
+                    $s['leave_days']++;
+                }
+                if ($date < $today || ($date === $today && $rec?->punch_in)) {
+                    $s['elapsed_days']++;
+                }
+                if ($row['status'] === 'absent') {
+                    $s['absent']++;
+                }
+            }
+            if ($p->isHoliday($day) && ! $p->isWeekend($day)) {
+                $s['holidays']++;
+            }
+
+            $days[] = $row;
+        }
+
+        $expected = max(0, $s['elapsed_days'] - $s['leave_days']);
+        $s['attendance_pct'] = $expected > 0 ? round(max(0, $s['present'] - 0.5 * $s['half_days']) / $expected * 100, 1) : null;
+        $s['avg_minutes'] = $s['worked_days'] > 0 ? (int) round($s['worked_minutes'] / $s['worked_days']) : null;
+
+        return [
+            'user' => $user,
+            'summary' => $s,
+            'days' => $days,
+        ];
+    }
+
+    private function totals(Collection $rows, Carbon $from, Carbon $to): array
+    {
+        $sum = fn ($k) => $rows->sum(fn ($r) => $r['summary'][$k]);
+        $pcts = $rows->pluck('summary.attendance_pct')->filter(fn ($v) => $v !== null);
+        $workedDays = $sum('worked_days');
+
+        return [
+            'employees' => $rows->count(),
+            'working_days' => $this->workingDays($from, $to),
+            'present' => $sum('present'),
+            'absent' => $sum('absent'),
+            'late' => $sum('late'),
+            'late_minutes' => $sum('late_minutes'),
+            'half_days' => $sum('half_days'),
+            'early_outs' => $sum('early_outs'),
+            'leave_days' => $sum('leave_days'),
+            'missed_punch_outs' => $sum('missed_punch_outs'),
+            'avg_minutes' => $workedDays > 0 ? (int) round($sum('worked_minutes') / $workedDays) : null,
+            'attendance_pct' => $pcts->isNotEmpty() ? round($pcts->avg(), 1) : null,
+        ];
+    }
+
+    /** Daily team counts, for the trend chart. */
+    private function trend(Collection $rows, Carbon $from, Carbon $to): array
+    {
+        $out = [];
+        foreach (CarbonPeriod::create($from, $to) as $i => $day) {
+            if (! $this->policy->isWorkingDay($day) || $day->isAfter(Carbon::today())) {
+                continue;
+            }
+            $counts = ['present' => 0, 'late' => 0, 'absent' => 0, 'leave' => 0];
+            foreach ($rows as $r) {
+                $st = $r['days'][$i]['status'] ?? null;
+                if (in_array($st, ['present', 'early_out', 'working', 'half_day'], true)) {
+                    $counts['present']++;
+                } elseif ($st === 'late') {
+                    $counts['late']++;
+                } elseif ($st === 'absent') {
+                    $counts['absent']++;
+                } elseif ($st === 'leave') {
+                    $counts['leave']++;
+                }
+            }
+            $out[] = ['date' => $day->toDateString(), 'label' => $day->format('d M')] + $counts;
+        }
+
+        return $out;
+    }
+
+    public function workingDays(Carbon $from, Carbon $to): int
+    {
+        $n = 0;
+        foreach (CarbonPeriod::create($from, $to) as $day) {
+            $n += $this->policy->isWorkingDay($day) ? 1 : 0;
+        }
+
+        return $n;
+    }
+
+    public static function statusLabel(string $status): string
+    {
+        return [
+            'present' => 'Present', 'late' => 'Late', 'half_day' => 'Half day', 'early_out' => 'Early out',
+            'absent' => 'Absent', 'leave' => 'On leave', 'holiday' => 'Holiday', 'weekend' => 'Weekend',
+            'upcoming' => '—', 'pending' => 'Not punched in', 'working' => 'Working', 'not_joined' => '—',
+        ][$status] ?? ucfirst(str_replace('_', ' ', $status));
+    }
+}
diff --git a/app/Services/Attendance/AttendanceService.php b/app/Services/Attendance/AttendanceService.php
new file mode 100644
index 0000000..eec1095
--- /dev/null
+++ b/app/Services/Attendance/AttendanceService.php
@@ -0,0 +1,367 @@
+<?php
+
+namespace App\Services\Attendance;
+
+use App\Models\Attendance;
+use App\Models\AttendanceNote;
+use App\Models\Automation;
+use App\Models\LeaveRequest;
+use App\Models\User;
+use Carbon\Carbon;
+use Illuminate\Contracts\Cache\LockTimeoutException;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Cache;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Punch in / punch out, the daily close (missed punch-outs and absences) and admin corrections.
+ *
+ * Overnight work: a record stays open until the next day's punch-in window opens (or noon on a
+ * day off), so someone who punches in at 18:00 can punch out at 02:00 and the record keeps the
+ * original date. After that it's treated as a missed punch-out.
+ */
+class AttendanceService
+{
+    public function __construct(private ?AttendancePolicy $policy = null)
+    {
+        $this->policy ??= AttendancePolicy::current();
+    }
+
+    public function policy(): AttendancePolicy
+    {
+        return $this->policy;
+    }
+
+    /* ------------------------------------------------------------------ punch */
+
+    /**
+     * @return array{ok:bool, message:string, attendance?:Attendance}
+     */
+    public function punchIn(User $user, ?float $lat = null, ?float $lng = null, ?Carbon $now = null): array
+    {
+        $now ??= Carbon::now();
+        $p = $this->policy;
+
+        if (! $p->configured) {
+            return $this->fail('Company settings not configured!');
+        }
+        if (! $user->track_attendance) {
+            return $this->fail('Attendance is not tracked for your account.');
+        }
+        if ($p->isHoliday($now)) {
+            return $this->fail('Today is a holiday!');
+        }
+        if ($p->isWeekend($now)) {
+            return $this->fail('Today is not a working day.');
+        }
+        $open = $p->at($now, $p->open);
+        if ($now->lt($open->copy()->subMinutes($p->earlyPunchInMinutes))) {
+            return $this->fail("Punch-in is only allowed {$p->earlyPunchInMinutes} minutes before office opens!");
+        }
+
+        if ($this->approvedLeaveOn($user, $now->toDateString())) {
+            return $this->fail('You are on approved leave today.');
+        }
+
+        return $this->locked($user, function () use ($user, $now, $open, $p, $lat, $lng) {
+            return DB::transaction(function () use ($user, $now, $open, $p, $lat, $lng) {
+                $date = $now->toDateString();
+
+                // Anything still open from earlier days is a missed punch-out.
+                Attendance::where('user_id', $user->id)->whereDate('date', '<', $date)
+                    ->whereNotNull('punch_in')->whereNull('punch_out')->lockForUpdate()->get()
+                    ->each(fn ($a) => $this->autoClose($a));
+                $existing = Attendance::where('user_id', $user->id)->whereDate('date', $date)->lockForUpdate()->first();
+
+                if ($existing && ($existing->punch_in || in_array($existing->status, ['leave', 'holiday'], true))) {
+                    return $this->fail($existing->punch_out
+                        ? 'You have already punched in and out today. You can punch in again tomorrow.'
+                        : 'Already punched in!');
+                }
+
+                // Early punch-ins are recorded at office opening time (existing behaviour).
+                $punchIn = $now->lt($open) ? $open : $now;
+                $data = [
+                    'punch_in' => $punchIn->format('H:i:s'),
+                    'punch_out' => null,
+                    'total_hours' => null,
+                    'status' => $p->statusForPunchIn($now),
+                    'location' => ($lat !== null && $lng !== null) ? round($lat, 7).','.round($lng, 7) : null,
+                    'auto_closed' => false,
+                ];
+
+                // A row may already exist without a punch-in (e.g. marked absent by an admin).
+                $attendance = $existing
+                    ? tap($existing)->update($data)
+                    : Attendance::create($data + ['user_id' => $user->id, 'date' => $date]);
+
+                return ['ok' => true, 'message' => 'Punched in successfully!', 'attendance' => $attendance];
+            });
+        });
+    }
+
+    /**
+     * @return array{ok:bool, message:string, attendance?:Attendance}
+     */
+    public function punchOut(User $user, ?Carbon $now = null): array
+    {
+        $now ??= Carbon::now();
+
+        return $this->locked($user, function () use ($user, $now) {
+            return DB::transaction(function () use ($user, $now) {
+                $attendance = $this->openRecord($user, $now, true)
+                    ?? Attendance::where('user_id', $user->id)->whereDate('date', $now->toDateString())->whereNotNull('punch_in')->whereNull('punch_out')->lockForUpdate()->first();
+
+                if (! $attendance) {
+                    $today = Attendance::where('user_id', $user->id)->whereDate('date', $now->toDateString())->first();
+
+                    return $this->fail($today && $today->punch_out
+                        ? 'You have already punched in and out today. You can punch in again tomorrow.'
+                        : "You haven't punched in today.");
+                }
+
+                $in = $this->policy->at($attendance->dateString(), $attendance->punch_in);
+                if ($now->lt($in)) {
+                    return $this->fail('Punch-out time cannot be before punch-in time.');
+                }
+
+                $attendance->punch_out = $now->format('H:i:s');
+                $attendance->total_hours = self::duration($in, $now);
+                $attendance->auto_closed = false;
+                // Early-out only replaces a plain "present"; late / half-day stay visible.
+                if ($attendance->status === 'present' && $this->policy->earlyOutMinutes($attendance) > 0) {
+                    $attendance->status = 'early_out';
+                }
+                $attendance->save();
+
+                return ['ok' => true, 'message' => 'Punched out successfully!', 'attendance' => $attendance];
+            });
+        });
+    }
+
+    /**
+     * An open record from a PREVIOUS day that can still be punched out (overnight work).
+     */
+    public function openRecord(User $user, Carbon $now, bool $lock = false): ?Attendance
+    {
+        if ($now->gte($this->policy->overnightCutoff($now))) {
+            return null;
+        }
+
+        $q = Attendance::where('user_id', $user->id)
+            ->whereDate('date', $now->copy()->subDay()->toDateString())
+            ->whereNotNull('punch_in')
+            ->whereNull('punch_out');
+
+        return ($lock ? $q->lockForUpdate() : $q)->first();
+    }
+
+    /**
+     * The widget's view of "today": the open overnight record if there is one, otherwise today's.
+     */
+    public function current(User $user, ?Carbon $now = null): ?Attendance
+    {
+        $now ??= Carbon::now();
+
+        return $this->openRecord($user, $now)
+            ?? Attendance::where('user_id', $user->id)->whereDate('date', $now->toDateString())->first();
+    }
+
+    public function approvedLeaveOn(User $user, string $date): ?LeaveRequest
+    {
+        return LeaveRequest::where('user_id', $user->id)
+            ->where('status', 'approved')
+            ->overlapping($date, $date)
+            ->with('type')
+            ->first();
+    }
+
+    /* -------------------------------------------------------------- daily close */
+
+    /**
+     * Close every finished day up to yesterday (or the day before, before noon):
+     *  - open records get punch_out = office closing time and auto_closed = true (missed punch-out)
+     *  - tracked employees with no record on a working day get "leave" (approved leave) or "absent"
+     * Safe to run many times; it only ever adds missing rows.
+     */
+    public function closeThrough(?Carbon $now = null, int $maxDays = 31): int
+    {
+        $now ??= Carbon::now();
+        $through = $now->copy()->subDay()->startOfDay();
+        if ($now->lt($this->policy->overnightCutoff($now))) {
+            $through->subDay();
+        }
+
+        $automation = Automation::firstOrCreate(['key' => 'attendance_closed_through']);
+        $from = $automation->last_run_date
+            ? Carbon::parse($automation->last_run_date)->addDay()->startOfDay()
+            : $through->copy();
+        if ($from->lt($through->copy()->subDays($maxDays - 1))) {
+            $from = $through->copy()->subDays($maxDays - 1);
+        }
+
+        $count = 0;
+        for ($d = $from->copy(); $d->lte($through); $d->addDay()) {
+            $count += $this->closeDay($d->toDateString());
+        }
+
+        if (! $automation->last_run_date || $through->gt($automation->last_run_date)) {
+            $automation->update(['last_run_date' => $through->toDateString()]);
+        }
+
+        return $count;
+    }
+
+    /** Close one date. Returns the number of rows created or closed. */
+    public function closeDay(string $date): int
+    {
+        $p = $this->policy;
+        $count = 0;
+
+        // 1. Missed punch-outs.
+        $open = Attendance::whereDate('date', $date)->whereNotNull('punch_in')->whereNull('punch_out')->get();
+        foreach ($open as $a) {
+            $this->autoClose($a);
+            $count++;
+        }
+
+        if (! $p->isWorkingDay($date)) {
+            return $count;
+        }
+
+        // 2. Absences / leave for working days.
+        $users = User::tracked()
+            ->where(fn ($q) => $q->whereNull('created_at')->orWhereDate('created_at', '<=', $date))
+            ->whereDoesntHave('attendances', fn ($q) => $q->whereDate('date', $date))
+            ->get(['id']);
+
+        $onLeave = LeaveRequest::where('status', 'approved')->overlapping($date, $date)->pluck('user_id')->all();
+
+        foreach ($users as $u) {
+            try {
+                Attendance::create([
+                    'user_id' => $u->id,
+                    'date' => $date,
+                    'status' => in_array($u->id, $onLeave) ? 'leave' : 'absent',
+                ]);
+                $count++;
+            } catch (QueryException $e) {
+                // Another process created it first (unique index) — fine.
+            }
+        }
+
+        return $count;
+    }
+
+    /** Missed punch-out: close at office closing time and flag it. */
+    private function autoClose(Attendance $a): void
+    {
+        $date = $a->dateString();
+        $in = $this->policy->at($date, $a->punch_in);
+        $out = $this->policy->at($date, $this->policy->close);
+        if ($out->lte($in)) {
+            $out = $in->copy(); // punched in after closing: zero hours rather than a negative time
+        }
+        $a->update(['punch_out' => $out->format('H:i:s'), 'total_hours' => self::duration($in, $out), 'auto_closed' => true]);
+    }
+
+    /* ------------------------------------------------------------ admin edits */
+
+    /**
+     * Admin correction of a record. The change and reason are kept as an attendance note.
+     */
+    public function correct(Attendance $attendance, array $data, User $editor, string $reason): Attendance
+    {
+        return DB::transaction(function () use ($attendance, $data, $editor, $reason) {
+            $before = $attendance->only(['punch_in', 'punch_out', 'status']);
+            $date = $attendance->dateString();
+            $p = $this->policy;
+
+            $in = ! empty($data['punch_in']) ? Carbon::parse($data['punch_in'])->format('H:i:s') : null;
+            $out = ! empty($data['punch_out']) ? Carbon::parse($data['punch_out'])->format('H:i:s') : null;
+            $status = $data['status'] ?? null;
+
+            if (! $in) {
+                $out = null;
+                $status = in_array($status, ['absent', 'leave', 'holiday'], true) ? $status : 'absent';
+            } elseif (! $status || in_array($status, ['absent', 'leave', 'holiday'], true)) {
+                $status = $p->statusForPunchIn($p->at($date, $in));
+            }
+
+            $total = null;
+            if ($in && $out) {
+                $inAt = $p->at($date, $in);
+                $outAt = $p->at($date, $out);
+                if ($outAt->lt($inAt)) {
+                    $outAt->addDay(); // overnight
+                }
+                $total = self::duration($inAt, $outAt);
+            }
+
+            $attendance->update([
+                'punch_in' => $in,
+                'punch_out' => $out,
+                'total_hours' => $total,
+                'status' => $status,
+                'auto_closed' => false,
+                'edited_by' => $editor->id,
+                'edited_at' => now(),
+            ]);
+
+            $after = $attendance->only(['punch_in', 'punch_out', 'status']);
+            $changes = collect($after)->filter(fn ($v, $k) => $before[$k] != $v)
+                ->map(fn ($v, $k) => str_replace('_', ' ', $k).': '.($before[$k] ?: '—').' → '.($v ?: '—'))
+                ->implode(', ');
+
+            AttendanceNote::create([
+                'attendance_id' => $attendance->id,
+                'user_id' => $editor->id,
+                'note' => '[Correction] '.($changes ?: 'no field changes').' — '.$reason,
+            ]);
+
+            return $attendance->fresh();
+        });
+    }
+
+    /** Admin creates a record for a day that has none. */
+    public function createFor(User $employee, string $date, array $data, User $editor, string $reason): Attendance
+    {
+        $attendance = Attendance::firstOrCreate(
+            ['user_id' => $employee->id, 'date' => $date],
+            ['status' => 'absent']
+        );
+
+        return $this->correct($attendance, $data, $editor, $reason);
+    }
+
+    /* ---------------------------------------------------------------- helpers */
+
+    public static function duration(Carbon $from, Carbon $to): string
+    {
+        $seconds = max(0, $from->diffInSeconds($to, false));
+        $seconds = min($seconds, 23 * 3600 + 59 * 60 + 59); // TIME column, single shift
+
+        return sprintf('%02d:%02d:%02d', intdiv($seconds, 3600), intdiv($seconds % 3600, 60), $seconds % 60);
+    }
+
+    private function fail(string $message): array
+    {
+        return ['ok' => false, 'message' => $message];
+    }
+
+    /** Per-user lock so double clicks / two devices can't both punch. */
+    private function locked(User $user, callable $callback): array
+    {
+        try {
+            return Cache::lock('attendance-punch:'.$user->id, 10)->block(5, $callback);
+        } catch (LockTimeoutException) {
+            return $this->fail('Another punch is being processed. Please try again.');
+        } catch (QueryException $e) {
+            // Unique index caught a race the lock didn't (e.g. cache store without locks).
+            if (str_contains($e->getMessage(), 'attendances_user_date_unique') || $e->getCode() === '23000') {
+                return $this->fail('Already punched in!');
+            }
+            throw $e;
+        }
+    }
+}
diff --git a/app/Services/Leave/LeaveService.php b/app/Services/Leave/LeaveService.php
new file mode 100644
index 0000000..c70b7d3
--- /dev/null
+++ b/app/Services/Leave/LeaveService.php
@@ -0,0 +1,490 @@
+<?php
+
+namespace App\Services\Leave;
+
+use App\Models\Attendance;
+use App\Models\GeneralSetting;
+use App\Models\LeaveBalance;
+use App\Models\LeaveBalanceAdjustment;
+use App\Models\LeaveRequest;
+use App\Models\LeaveRequestEvent;
+use App\Models\LeaveType;
+use App\Models\User;
+use App\Services\Attendance\AttendancePolicy;
+use App\Support\Access;
+use App\Support\InAppNotification;
+use Carbon\Carbon;
+use Carbon\CarbonPeriod;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Leave balances and the request workflow.
+ *
+ * Leave year: starts on the 1st of general_settings.leave_year_start_month (default January) and
+ * is identified by the calendar year it starts in. Each person gets a balance row per leave type
+ * per leave year, created the first time it's needed, with the allowance COPIED from the policy
+ * at that moment. Changing the policy updates the current year's balances only (past years stay
+ * as they were). Unused days carry forward up to the type's carry_forward_max (0 = reset).
+ *
+ * Days: only working days count (weekends and public holidays inside a range are free). The
+ * split per leave year is stored on the request, so a 29 Dec – 3 Jan request draws from both years.
+ */
+class LeaveService
+{
+    /** How far back an employee may apply (sick leave filed after the fact, etc.). */
+    public const MAX_BACKDATE_DAYS = 60;
+
+    /** Read per call: holidays / working days may change while a long-lived instance exists. */
+    private function policy(): AttendancePolicy
+    {
+        return AttendancePolicy::current();
+    }
+
+    /* ----------------------------------------------------------- leave years */
+
+    public function startMonth(): int
+    {
+        $m = (int) (GeneralSetting::first()->leave_year_start_month ?? 1);
+
+        return $m >= 1 && $m <= 12 ? $m : 1;
+    }
+
+    public function yearOf(Carbon|string $date): int
+    {
+        $d = Carbon::parse($date);
+
+        return $d->month >= $this->startMonth() ? $d->year : $d->year - 1;
+    }
+
+    public function currentYear(): int
+    {
+        return $this->yearOf(Carbon::today());
+    }
+
+    /** @return array{0:Carbon,1:Carbon} */
+    public function yearRange(int $year): array
+    {
+        $start = Carbon::create($year, $this->startMonth(), 1)->startOfDay();
+
+        return [$start, $start->copy()->addYear()->subDay()];
+    }
+
+    public function yearLabel(int $year): string
+    {
+        if ($this->startMonth() === 1) {
+            return (string) $year;
+        }
+        [$s, $e] = $this->yearRange($year);
+
+        return $s->format('M Y').' – '.$e->format('M Y');
+    }
+
+    /** Working dates (Y-m-d) between two dates, inclusive. */
+    public function workingDates(Carbon|string $from, Carbon|string $to): array
+    {
+        $dates = [];
+        foreach (CarbonPeriod::create(Carbon::parse($from), Carbon::parse($to)) as $d) {
+            if ($this->policy()->isWorkingDay($d)) {
+                $dates[] = $d->toDateString();
+            }
+        }
+
+        return $dates;
+    }
+
+    /** @return array<string,float> leave year => days */
+    public function daysByYear(Carbon|string $from, Carbon|string $to): array
+    {
+        $out = [];
+        foreach ($this->workingDates($from, $to) as $d) {
+            $y = (string) $this->yearOf($d);
+            $out[$y] = ($out[$y] ?? 0) + 1;
+        }
+
+        return $out;
+    }
+
+    /* -------------------------------------------------------------- balances */
+
+    /** The person's balance row for a type and year, created with today's policy if missing. */
+    public function balance(User $user, LeaveType $type, int $year): LeaveBalance
+    {
+        $existing = LeaveBalance::where(['user_id' => $user->id, 'leave_type_id' => $type->id, 'year' => $year])->first();
+        if ($existing) {
+            return $existing;
+        }
+
+        $carry = 0.0;
+        if ($type->isLimited() && $type->carry_forward_max > 0) {
+            $prev = LeaveBalance::where(['user_id' => $user->id, 'leave_type_id' => $type->id, 'year' => $year - 1])->first();
+            if ($prev && $prev->entitlement() !== null) {
+                $left = $prev->entitlement() - $this->used($user, $type, $year - 1);
+                $carry = min(max(0, $left), (float) $type->carry_forward_max);
+            }
+        }
+
+        try {
+            return LeaveBalance::create([
+                'user_id' => $user->id,
+                'leave_type_id' => $type->id,
+                'year' => $year,
+                'allowance' => $type->currentAllowance(),
+                'carried_forward' => $carry,
+                'adjustment' => 0,
+            ]);
+        } catch (QueryException) {
+            // Created concurrently.
+            return LeaveBalance::where(['user_id' => $user->id, 'leave_type_id' => $type->id, 'year' => $year])->firstOrFail();
+        }
+    }
+
+    /** Days used in a leave year (approved, or with $statuses e.g. ['pending']). */
+    public function used(User $user, LeaveType $type, int $year, array $statuses = ['approved']): float
+    {
+        [$s, $e] = $this->yearRange($year);
+
+        return (float) LeaveRequest::where('user_id', $user->id)
+            ->where('leave_type_id', $type->id)
+            ->whereIn('status', $statuses)
+            ->overlapping($s->toDateString(), $e->toDateString())
+            ->get(['id', 'year_days'])
+            ->sum(fn ($r) => $r->daysInYear($year));
+    }
+
+    /**
+     * Balance summary per active leave type.
+     *
+     * @return Collection<int, array{type:LeaveType, allowance:?float, carried:float, adjustment:float, entitlement:?float, used:float, pending:float, remaining:?float, available:?float}>
+     */
+    public function summary(User $user, ?int $year = null, ?Collection $types = null): Collection
+    {
+        $year ??= $this->currentYear();
+        $types ??= LeaveType::active()->get();
+
+        return $types->map(function (LeaveType $type) use ($user, $year) {
+            $b = $this->balance($user, $type, $year);
+            $used = $this->used($user, $type, $year);
+            $pending = $this->used($user, $type, $year, ['pending']);
+            $ent = $b->entitlement();
+
+            return [
+                'type' => $type,
+                'balance' => $b,
+                'allowance' => $b->allowance,
+                'carried' => $b->carried_forward,
+                'adjustment' => $b->adjustment,
+                'entitlement' => $ent,
+                'used' => $used,
+                'pending' => $pending,
+                'remaining' => $ent === null ? null : $ent - $used,
+                'available' => $ent === null ? null : $ent - $used - $pending,
+            ];
+        })->values();
+    }
+
+    /* ------------------------------------------------------------- workflow */
+
+    /** What a request would cost, without saving. */
+    public function preview(User $user, LeaveType $type, string $from, string $to): array
+    {
+        $byYear = $this->daysByYear($from, $to);
+        $years = [];
+        foreach ($byYear as $y => $days) {
+            $s = $this->summary($user, (int) $y, collect([$type]))->first();
+            $years[] = ['year' => (int) $y, 'label' => $this->yearLabel((int) $y), 'days' => $days, 'available' => $s['available']];
+        }
+
+        return [
+            'days' => array_sum($byYear),
+            'years' => $years,
+            'overlap' => $this->overlapFor($user, $from, $to)?->only(['id', 'start_date', 'end_date', 'status']),
+        ];
+    }
+
+    public function apply(User $user, array $data): LeaveRequest
+    {
+        $type = LeaveType::where('id', $data['leave_type_id'] ?? 0)->where('is_active', true)->first();
+        if (! $type) {
+            throw ValidationException::withMessages(['leave_type_id' => 'Choose a valid leave type.']);
+        }
+
+        $from = Carbon::parse($data['start_date'])->startOfDay();
+        $to = Carbon::parse($data['end_date'])->startOfDay();
+        $reason = trim((string) ($data['reason'] ?? ''));
+
+        if ($to->lt($from)) {
+            throw ValidationException::withMessages(['end_date' => 'The end date must be on or after the start date.']);
+        }
+        if ($from->lt(Carbon::today()->subDays(self::MAX_BACKDATE_DAYS))) {
+            throw ValidationException::withMessages(['start_date' => 'Leave can be applied at most '.self::MAX_BACKDATE_DAYS.' days back.']);
+        }
+        if ($to->gt(Carbon::today()->addYear())) {
+            throw ValidationException::withMessages(['end_date' => 'Leave can be applied at most one year ahead.']);
+        }
+        if ($from->diffInDays($to) > 366) {
+            throw ValidationException::withMessages(['end_date' => 'A single request cannot be longer than a year.']);
+        }
+        if ($type->requires_reason && $reason === '') {
+            throw ValidationException::withMessages(['reason' => "A reason is required for {$type->name}."]);
+        }
+
+        $byYear = $this->daysByYear($from, $to);
+        $days = array_sum($byYear);
+        if ($days <= 0) {
+            throw ValidationException::withMessages(['end_date' => 'The selected dates are all weekends or holidays — no leave is needed.']);
+        }
+
+        $request = DB::transaction(function () use ($user, $type, $from, $to, $reason, $byYear, $days) {
+            // Serialise this person's requests so two submissions can't both pass the checks.
+            User::whereKey($user->id)->lockForUpdate()->first();
+
+            if ($overlap = $this->overlapFor($user, $from->toDateString(), $to->toDateString())) {
+                throw ValidationException::withMessages(['start_date' => sprintf(
+                    'These dates overlap your %s request for %s – %s.',
+                    $overlap->status,
+                    $overlap->start_date->format('d M Y'),
+                    $overlap->end_date->format('d M Y')
+                )]);
+            }
+
+            $this->assertBalance($user, $type, $byYear);
+
+            $req = LeaveRequest::create([
+                'user_id' => $user->id,
+                'leave_type_id' => $type->id,
+                'start_date' => $from->toDateString(),
+                'end_date' => $to->toDateString(),
+                'days' => $days,
+                'year_days' => $byYear,
+                'reason' => $reason ?: null,
+                'status' => 'pending',
+            ]);
+            $this->log($req, $user, 'submitted', null, ['days' => $days, 'year_days' => $byYear]);
+
+            return $req;
+        });
+
+        $request->load('type', 'user');
+        foreach ($this->approvers()->where('id', '!=', $user->id) as $approver) {
+            InAppNotification::send($approver, 'Leave request', "{$user->name} requested {$this->fmt($days)} of {$type->name} ({$this->range($request)}).", route('leaves.admin', ['status' => 'pending']));
+        }
+
+        return $request;
+    }
+
+    public function approve(LeaveRequest $request, User $approver, ?string $comment = null): LeaveRequest
+    {
+        $this->assertCanReview($request, $approver);
+
+        $request = DB::transaction(function () use ($request, $approver, $comment) {
+            $req = LeaveRequest::whereKey($request->id)->lockForUpdate()->firstOrFail();
+            if ($req->status !== 'pending') {
+                throw ValidationException::withMessages(['status' => "This request is already {$req->status}."]);
+            }
+            User::whereKey($req->user_id)->lockForUpdate()->first();
+
+            // Re-check: approved days + this request must still fit (other pending requests don't block).
+            $this->assertBalance($req->user, $req->type, $req->year_days ?? [], ['approved'], 'approve');
+
+            $req->update(['status' => 'approved', 'reviewed_by' => $approver->id, 'reviewed_at' => now(), 'review_comment' => $comment ?: null]);
+            $this->log($req, $approver, 'approved', $comment);
+
+            // Days already marked absent become leave (punched days are left alone).
+            Attendance::where('user_id', $req->user_id)
+                ->whereBetween('date', [$req->start_date->toDateString(), $req->end_date->toDateString()])
+                ->whereNull('punch_in')
+                ->where('status', 'absent')
+                ->update(['status' => 'leave']);
+
+            return $req;
+        });
+
+        InAppNotification::send($request->user, 'Leave approved', "Your {$request->type->name} for {$this->range($request)} was approved.".($comment ? " Comment: {$comment}" : ''), route('leaves.index'));
+
+        return $request->fresh(['type', 'user', 'reviewer']);
+    }
+
+    public function reject(LeaveRequest $request, User $approver, ?string $comment = null): LeaveRequest
+    {
+        $this->assertCanReview($request, $approver);
+
+        DB::transaction(function () use ($request, $approver, $comment) {
+            $req = LeaveRequest::whereKey($request->id)->lockForUpdate()->firstOrFail();
+            if ($req->status !== 'pending') {
+                throw ValidationException::withMessages(['status' => "This request is already {$req->status}."]);
+            }
+            $req->update(['status' => 'rejected', 'reviewed_by' => $approver->id, 'reviewed_at' => now(), 'review_comment' => $comment ?: null]);
+            $this->log($req, $approver, 'rejected', $comment);
+        });
+
+        InAppNotification::send($request->user, 'Leave rejected', "Your {$request->type->name} for {$this->range($request)} was rejected.".($comment ? " Comment: {$comment}" : ''), route('leaves.index'));
+
+        return $request->fresh(['type', 'user', 'reviewer']);
+    }
+
+    /** Employee withdraws their own pending request. */
+    public function cancel(LeaveRequest $request, User $user): LeaveRequest
+    {
+        if ((int) $request->user_id !== (int) $user->id) {
+            abort(403, 'You can only cancel your own requests.');
+        }
+
+        DB::transaction(function () use ($request, $user) {
+            $req = LeaveRequest::whereKey($request->id)->lockForUpdate()->firstOrFail();
+            if ($req->status !== 'pending') {
+                throw ValidationException::withMessages(['status' => 'Only pending requests can be cancelled. Ask an approver to revoke an approved leave.']);
+            }
+            $req->update(['status' => 'cancelled']);
+            $this->log($req, $user, 'cancelled');
+        });
+
+        return $request->fresh();
+    }
+
+    /** Approver cancels an approved leave; the days return to the balance. */
+    public function revoke(LeaveRequest $request, User $approver, ?string $comment = null): LeaveRequest
+    {
+        $this->assertCanReview($request, $approver);
+
+        DB::transaction(function () use ($request, $approver, $comment) {
+            $req = LeaveRequest::whereKey($request->id)->lockForUpdate()->firstOrFail();
+            if ($req->status !== 'approved') {
+                throw ValidationException::withMessages(['status' => 'Only approved requests can be revoked.']);
+            }
+            $req->update(['status' => 'cancelled', 'reviewed_by' => $approver->id, 'reviewed_at' => now(), 'review_comment' => $comment ?: $req->review_comment]);
+            $this->log($req, $approver, 'revoked', $comment);
+
+            // Leave rows for past days go back to absent; nothing is deleted.
+            Attendance::where('user_id', $req->user_id)
+                ->whereBetween('date', [$req->start_date->toDateString(), $req->end_date->toDateString()])
+                ->whereNull('punch_in')
+                ->where('status', 'leave')
+                ->update(['status' => 'absent']);
+        });
+
+        InAppNotification::send($request->user, 'Leave revoked', "Your {$request->type->name} for {$this->range($request)} was revoked.".($comment ? " Comment: {$comment}" : ''), route('leaves.index'));
+
+        return $request->fresh(['type', 'user', 'reviewer']);
+    }
+
+    /** Manual +/- days on a person's balance, with a reason (audited). */
+    public function adjust(User $user, LeaveType $type, int $year, float $days, string $reason, User $admin): LeaveBalance
+    {
+        if ($days == 0) {
+            throw ValidationException::withMessages(['days' => 'Enter a non-zero number of days.']);
+        }
+
+        return DB::transaction(function () use ($user, $type, $year, $days, $reason, $admin) {
+            $b = $this->balance($user, $type, $year);
+            $b = LeaveBalance::whereKey($b->id)->lockForUpdate()->first();
+            if ($b->allowance === null) {
+                throw ValidationException::withMessages(['days' => "{$type->name} has no limit, so there is nothing to adjust."]);
+            }
+            $b->update(['adjustment' => $b->adjustment + $days]);
+            LeaveBalanceAdjustment::create(['leave_balance_id' => $b->id, 'user_id' => $admin->id, 'days' => $days, 'reason' => $reason, 'created_at' => now()]);
+
+            return $b;
+        });
+    }
+
+    /**
+     * After the annual allowance or a type's allowance changes: update the CURRENT leave year's
+     * balances (and later years already created). Earlier years keep the allowance they had.
+     */
+    public function syncAllowances(?LeaveType $only = null): int
+    {
+        $year = $this->currentYear();
+        $n = 0;
+        $types = $only ? collect([$only]) : LeaveType::all();
+        foreach ($types as $type) {
+            $n += LeaveBalance::where('leave_type_id', $type->id)
+                ->where('year', '>=', $year)
+                ->update(['allowance' => $type->currentAllowance()]);
+        }
+
+        return $n;
+    }
+
+    /* --------------------------------------------------------------- helpers */
+
+    public function overlapFor(User $user, string $from, string $to, ?int $ignoreId = null): ?LeaveRequest
+    {
+        return LeaveRequest::where('user_id', $user->id)
+            ->active()
+            ->overlapping($from, $to)
+            ->when($ignoreId, fn ($q) => $q->where('id', '!=', $ignoreId))
+            ->first();
+    }
+
+    /** Users who can approve leave. */
+    public function approvers(): Collection
+    {
+        return User::with('roles.permissions')->get()->filter(fn ($u) => Access::approveLeaves($u))->values();
+    }
+
+    /**
+     * @param  array<string,float>  $byYear
+     */
+    private function assertBalance(User $user, LeaveType $type, array $byYear, array $counted = ['approved', 'pending'], string $mode = 'apply'): void
+    {
+        if (! $type->isLimited() || $type->allow_negative) {
+            return;
+        }
+        foreach ($byYear as $year => $days) {
+            $b = $this->balance($user, $type, (int) $year);
+            $ent = $b->entitlement();
+            if ($ent === null) {
+                continue;
+            }
+            $taken = $this->used($user, $type, (int) $year, $counted);
+            $left = $ent - $taken;
+            if ($days > $left + 0.0001) {
+                $label = $this->yearLabel((int) $year);
+                $msg = $mode === 'approve'
+                    ? "Not enough {$type->name} balance to approve: {$this->fmt($days)} requested in {$label}, {$this->fmt(max(0, $left))} left."
+                    : "Not enough {$type->name} balance: you asked for {$this->fmt($days)} in {$label} but only {$this->fmt(max(0, $left))} available"
+                        .($counted === ['approved', 'pending'] ? ' (pending requests included).' : '.');
+                throw ValidationException::withMessages(['leave_type_id' => $msg]);
+            }
+        }
+    }
+
+    private function assertCanReview(LeaveRequest $request, User $approver): void
+    {
+        if (! Access::approveLeaves($approver)) {
+            abort(403, 'You are not allowed to review leave requests.');
+        }
+        if ((int) $request->user_id === (int) $approver->id && ! $approver->hasRole('ADMIN')) {
+            abort(403, 'You cannot review your own leave request.');
+        }
+    }
+
+    private function log(LeaveRequest $req, ?User $by, string $action, ?string $comment = null, ?array $meta = null): void
+    {
+        LeaveRequestEvent::create([
+            'leave_request_id' => $req->id,
+            'user_id' => $by?->id,
+            'action' => $action,
+            'comment' => $comment ?: null,
+            'meta' => $meta,
+            'created_at' => now(),
+        ]);
+    }
+
+    public function fmt(float $days): string
+    {
+        $n = rtrim(rtrim(number_format($days, 1), '0'), '.');
+
+        return $n.' '.($days == 1 ? 'day' : 'days');
+    }
+
+    private function range(LeaveRequest $r): string
+    {
+        return $r->start_date->equalTo($r->end_date)
+            ? $r->start_date->format('d M Y')
+            : $r->start_date->format('d M').' – '.$r->end_date->format('d M Y');
+    }
+}
