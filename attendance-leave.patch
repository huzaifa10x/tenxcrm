diff --git a/app/Http/Controllers/LeaveController.php b/app/Http/Controllers/LeaveController.php
new file mode 100644
index 0000000..ccf356a
--- /dev/null
+++ b/app/Http/Controllers/LeaveController.php
@@ -0,0 +1,243 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\LeaveRequest;
+use App\Models\LeaveType;
+use App\Models\Role;
+use App\Models\User;
+use App\Services\Leave\LeaveService;
+use App\Support\Access;
+use Carbon\Carbon;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Validation\Rule;
+
+class LeaveController extends Controller
+{
+    public function __construct(private LeaveService $leaves) {}
+
+    /* ------------------------------------------------------------- employee */
+
+    public function index(Request $request)
+    {
+        $me = Auth::user();
+        $year = (int) $request->input('year', $this->leaves->currentYear());
+        $status = $request->input('status');
+
+        $requests = LeaveRequest::where('user_id', $me->id)
+            ->with(['type', 'reviewer:id,name'])
+            ->when(in_array($status, LeaveRequest::STATUSES, true), fn ($q) => $q->where('status', $status))
+            ->orderByDesc('start_date')
+            ->paginate(15)
+            ->withQueryString();
+
+        $counts = LeaveRequest::where('user_id', $me->id)->selectRaw('status, count(*) as n')->groupBy('status')->pluck('n', 'status');
+
+        return view('leaves.index', [
+            'summary' => $this->leaves->summary($me, $year),
+            'year' => $year,
+            'yearLabel' => $this->leaves->yearLabel($year),
+            'yearRange' => $this->leaves->yearRange($year),
+            'years' => $this->yearOptions(),
+            'requests' => $requests,
+            'counts' => $counts,
+            'status' => $status,
+            'types' => LeaveType::active()->get(),
+            'upcoming' => LeaveRequest::where('user_id', $me->id)->where('status', 'approved')->whereDate('end_date', '>=', today())->with('type')->orderBy('start_date')->limit(5)->get(),
+            'canApprove' => Access::approveLeaves($me),
+        ]);
+    }
+
+    public function preview(Request $request)
+    {
+        $data = $request->validate([
+            'leave_type_id' => 'required|integer|exists:leave_types,id',
+            'start_date' => 'required|date',
+            'end_date' => 'required|date|after_or_equal:start_date',
+        ]);
+
+        return response()->json($this->leaves->preview(Auth::user(), LeaveType::findOrFail($data['leave_type_id']), $data['start_date'], $data['end_date']));
+    }
+
+    public function store(Request $request)
+    {
+        $data = $request->validate([
+            'leave_type_id' => 'required|integer|exists:leave_types,id',
+            'start_date' => 'required|date',
+            'end_date' => 'required|date|after_or_equal:start_date',
+            'reason' => 'nullable|string|max:1000',
+        ], [
+            'end_date.after_or_equal' => 'The end date must be on or after the start date.',
+        ]);
+
+        $leave = $this->leaves->apply(Auth::user(), $data);
+
+        $msg = 'Leave request submitted for '.$this->leaves->fmt($leave->days).'. You will be notified when it is reviewed.';
+
+        return $request->expectsJson()
+            ? response()->json(['success' => $msg, 'id' => $leave->id])
+            : redirect()->route('leaves.index')->with('success', $msg);
+    }
+
+    public function cancel(Request $request, LeaveRequest $leave)
+    {
+        $this->leaves->cancel($leave, Auth::user());
+
+        return $this->done($request, 'Leave request cancelled.');
+    }
+
+    /** Request details + timeline (owner or approvers). */
+    public function show(LeaveRequest $leave)
+    {
+        $me = Auth::user();
+        abort_unless((int) $leave->user_id === (int) $me->id || Access::approveLeaves($me), 403);
+
+        $leave->load(['type', 'user.roles', 'reviewer:id,name', 'events.user:id,name']);
+
+        $years = collect($leave->year_days ?? [])->map(function ($days, $y) use ($leave) {
+            $s = $this->leaves->summary($leave->user, (int) $y, collect([$leave->type]))->first();
+
+            return [
+                'year' => $this->leaves->yearLabel((int) $y),
+                'days' => $days,
+                'entitlement' => $s['entitlement'],
+                'used' => $s['used'],
+                'pending' => $s['pending'],
+                'remaining' => $s['remaining'],
+            ];
+        })->values();
+
+        $overlapsTeam = LeaveRequest::where('status', 'approved')
+            ->where('user_id', '!=', $leave->user_id)
+            ->overlapping($leave->start_date->toDateString(), $leave->end_date->toDateString())
+            ->with('user:id,name')
+            ->get()
+            ->map(fn ($r) => $r->user?->name.' ('.$r->start_date->format('d M').' – '.$r->end_date->format('d M').')');
+
+        return response()->json([
+            'id' => $leave->id,
+            'employee' => $leave->user->name,
+            'department' => $leave->user->departmentNames(),
+            'type' => $leave->type->name,
+            'type_color' => $leave->type->color,
+            'limited' => $leave->type->isLimited(),
+            'start' => $leave->start_date->format('D, d M Y'),
+            'end' => $leave->end_date->format('D, d M Y'),
+            'days' => $leave->days,
+            'reason' => $leave->reason,
+            'status' => $leave->status,
+            'review_comment' => $leave->review_comment,
+            'reviewer' => $leave->reviewer?->name,
+            'balance' => $years,
+            'team_overlap' => $overlapsTeam,
+            'events' => $leave->events->map(fn ($e) => [
+                'action' => $e->action,
+                'by' => $e->user?->name,
+                'comment' => $e->comment,
+                'at' => $e->created_at?->format('d M Y, h:i A'),
+            ]),
+            'can_review' => Access::approveLeaves($me) && ((int) $leave->user_id !== (int) $me->id || $me->hasRole('ADMIN')),
+            'can_cancel' => (int) $leave->user_id === (int) $me->id && $leave->status === 'pending',
+        ]);
+    }
+
+    /* ---------------------------------------------------------------- admin */
+
+    public function admin(Request $request)
+    {
+        $me = Auth::user();
+        abort_unless(Access::approveLeaves($me), 403);
+
+        $data = $request->validate([
+            'status' => ['nullable', Rule::in(array_merge(LeaveRequest::STATUSES, ['all']))],
+            'user_id' => 'nullable|integer',
+            'department' => 'nullable|integer',
+            'leave_type_id' => 'nullable|integer',
+            'from' => 'nullable|date',
+            'to' => 'nullable|date',
+            'q' => 'nullable|string|max:100',
+        ]);
+        $status = $data['status'] ?? 'pending';
+
+        $requests = LeaveRequest::with(['type', 'user.roles', 'reviewer:id,name'])
+            ->when($status !== 'all', fn ($q) => $q->where('status', $status))
+            ->when($data['user_id'] ?? null, fn ($q, $id) => $q->where('user_id', $id))
+            ->when($data['leave_type_id'] ?? null, fn ($q, $id) => $q->where('leave_type_id', $id))
+            ->when($data['department'] ?? null, fn ($q, $id) => $q->whereHas('user.roles', fn ($r) => $r->where('roles.id', $id)))
+            ->when($data['from'] ?? null, fn ($q, $d) => $q->whereDate('end_date', '>=', $d))
+            ->when($data['to'] ?? null, fn ($q, $d) => $q->whereDate('start_date', '<=', $d))
+            ->when(trim($data['q'] ?? ''), fn ($q, $s) => $q->whereHas('user', fn ($u) => $u->where('name', 'like', "%{$s}%")))
+            ->orderByRaw("CASE WHEN status = 'pending' THEN 0 ELSE 1 END")
+            ->orderBy($status === 'pending' ? 'start_date' : 'updated_at', $status === 'pending' ? 'asc' : 'desc')
+            ->paginate(20)
+            ->withQueryString();
+
+        $counts = LeaveRequest::selectRaw('status, count(*) as n')->groupBy('status')->pluck('n', 'status');
+
+        $today = Carbon::today();
+        $upcoming = LeaveRequest::where('status', 'approved')
+            ->whereDate('end_date', '>=', $today)
+            ->whereDate('start_date', '<=', $today->copy()->addDays(30))
+            ->with(['user:id,name', 'type:id,name,color'])
+            ->orderBy('start_date')
+            ->get();
+
+        return view('leaves.admin', [
+            'requests' => $requests,
+            'counts' => $counts,
+            'status' => $status,
+            'filters' => $data,
+            'upcoming' => $upcoming,
+            'employees' => User::tracked()->orderBy('name')->get(['id', 'name']),
+            'departments' => Role::orderBy('name')->get(['id', 'name']),
+            'types' => LeaveType::orderBy('sort')->get(),
+            'canPolicies' => Access::manageLeavePolicies($me),
+        ]);
+    }
+
+    public function approve(Request $request, LeaveRequest $leave)
+    {
+        $data = $request->validate(['comment' => 'nullable|string|max:1000']);
+        $this->leaves->approve($leave, Auth::user(), $data['comment'] ?? null);
+
+        return $this->done($request, 'Leave approved. '.$leave->user->name.' has been notified.');
+    }
+
+    public function reject(Request $request, LeaveRequest $leave)
+    {
+        $data = $request->validate(['comment' => 'nullable|string|max:1000']);
+        $this->leaves->reject($leave, Auth::user(), $data['comment'] ?? null);
+
+        return $this->done($request, 'Leave rejected. '.$leave->user->name.' has been notified.');
+    }
+
+    public function revoke(Request $request, LeaveRequest $leave)
+    {
+        $data = $request->validate(['comment' => 'nullable|string|max:1000']);
+        $this->leaves->revoke($leave, Auth::user(), $data['comment'] ?? null);
+
+        return $this->done($request, 'Approved leave revoked; the days are back in the balance.');
+    }
+
+    /* -------------------------------------------------------------- helpers */
+
+    private function done(Request $request, string $message)
+    {
+        return $request->expectsJson()
+            ? response()->json(['success' => $message])
+            : back()->with('success', $message);
+    }
+
+    private function yearOptions(): array
+    {
+        $current = $this->leaves->currentYear();
+        $first = (int) (LeaveRequest::min('start_date') ? $this->leaves->yearOf(LeaveRequest::min('start_date')) : $current);
+        $years = [];
+        for ($y = $current + 1; $y >= min($first, $current - 1); $y--) {
+            $years[$y] = $this->leaves->yearLabel($y);
+        }
+
+        return $years;
+    }
+}
diff --git a/app/Http/Controllers/LeavePolicyController.php b/app/Http/Controllers/LeavePolicyController.php
new file mode 100644
index 0000000..1e5548f
--- /dev/null
+++ b/app/Http/Controllers/LeavePolicyController.php
@@ -0,0 +1,166 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\GeneralSetting;
+use App\Models\LeaveBalanceAdjustment;
+use App\Models\LeaveType;
+use App\Models\User;
+use App\Services\Leave\LeaveService;
+use App\Support\Access;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Illuminate\Validation\Rule;
+
+/**
+ * Leave policies: the annual allowance and leave year (stored on general_settings),
+ * leave types, per-person balances and adjustments, and who is tracked in attendance.
+ */
+class LeavePolicyController extends Controller
+{
+    public function __construct(private LeaveService $leaves) {}
+
+    public function index(Request $request)
+    {
+        $me = Auth::user();
+        abort_unless(Access::manageLeavePolicies($me), 403);
+
+        $year = (int) $request->input('year', $this->leaves->currentYear());
+        $types = LeaveType::orderBy('sort')->orderBy('name')->get();
+        $activeLimited = $types->where('is_active', true)->filter->isLimited()->values();
+
+        $people = User::with('roles')->orderBy('name')->get()->filter(fn ($u) => $u->email !== 'system@10xdigital.ae')->values();
+        $balances = $people->where('track_attendance', true)->mapWithKeys(fn ($u) => [$u->id => $this->leaves->summary($u, $year, $activeLimited)]);
+
+        return view('leaves.policies', [
+            'settings' => GeneralSetting::first(),
+            'types' => $types,
+            'limitedTypes' => $activeLimited,
+            'people' => $people,
+            'balances' => $balances,
+            'year' => $year,
+            'yearLabel' => $this->leaves->yearLabel($year),
+            'currentYear' => $this->leaves->currentYear(),
+            'recentAdjustments' => LeaveBalanceAdjustment::with(['balance.user:id,name', 'balance.type:id,name', 'admin:id,name'])->latest('created_at')->limit(15)->get(),
+            'canManageAttendance' => Access::manageAttendance($me),
+        ]);
+    }
+
+    public function updateSettings(Request $request)
+    {
+        abort_unless(Access::manageLeavePolicies(Auth::user()), 403);
+
+        $data = $request->validate([
+            'annual_leave_allowance' => 'required|integer|min:0|max:365',
+            'leave_year_start_month' => 'required|integer|min:1|max:12',
+        ]);
+
+        $settings = GeneralSetting::firstOrCreate([]);
+        $before = $settings->only(['annual_leave_allowance', 'leave_year_start_month']);
+        $settings->update($data);
+
+        $synced = DB::transaction(fn () => $this->leaves->syncAllowances());
+
+        Log::info('Leave settings changed', ['by' => Auth::id(), 'before' => $before, 'after' => $data]);
+
+        return response()->json([
+            'success' => "Saved. Annual allowance is now {$data['annual_leave_allowance']} days; {$synced} balance(s) for the current leave year were updated. Earlier years keep their original allowance.",
+        ]);
+    }
+
+    public function storeType(Request $request)
+    {
+        abort_unless(Access::manageLeavePolicies(Auth::user()), 403);
+        $data = $this->validateType($request);
+        $data['code'] = Str::slug($data['name'], '_');
+        if (LeaveType::where('code', $data['code'])->exists()) {
+            $data['code'] .= '_'.Str::lower(Str::random(4));
+        }
+        $data['sort'] = (int) LeaveType::max('sort') + 1;
+
+        $type = LeaveType::create($data);
+
+        return response()->json(['success' => "{$type->name} added."]);
+    }
+
+    public function updateType(Request $request, LeaveType $type)
+    {
+        abort_unless(Access::manageLeavePolicies(Auth::user()), 403);
+        $data = $this->validateType($request, $type);
+
+        DB::transaction(function () use ($type, $data) {
+            $allowanceChanged = $type->allowance_source !== $data['allowance_source'] || (float) $type->days_per_year !== (float) ($data['days_per_year'] ?? 0);
+            $type->update($data);
+            if ($allowanceChanged) {
+                $this->leaves->syncAllowances($type->fresh());
+            }
+        });
+
+        return response()->json(['success' => "{$type->name} updated. Changes apply to the current leave year onwards."]);
+    }
+
+    public function adjust(Request $request)
+    {
+        $admin = Auth::user();
+        abort_unless(Access::manageLeavePolicies($admin), 403);
+
+        $data = $request->validate([
+            'user_id' => 'required|integer|exists:users,id',
+            'leave_type_id' => 'required|integer|exists:leave_types,id',
+            'year' => 'required|integer|min:2000|max:2100',
+            'days' => 'required|numeric|between:-365,365',
+            'reason' => 'required|string|min:3|max:255',
+        ]);
+
+        $b = $this->leaves->adjust(User::findOrFail($data['user_id']), LeaveType::findOrFail($data['leave_type_id']), (int) $data['year'], round((float) $data['days'] * 2) / 2, $data['reason'], $admin);
+
+        return response()->json(['success' => 'Balance adjusted. New entitlement: '.rtrim(rtrim(number_format($b->entitlement(), 1), '0'), '.').' days.']);
+    }
+
+    public function tracking(Request $request, User $user)
+    {
+        $me = Auth::user();
+        abort_unless(Access::manageAttendance($me) || Access::manageLeavePolicies($me), 403);
+        $data = $request->validate(['track_attendance' => 'required|boolean']);
+
+        $user->forceFill(['track_attendance' => (bool) $data['track_attendance']])->save();
+        Log::info('Attendance tracking changed', ['by' => $me->id, 'user' => $user->id, 'track' => $user->track_attendance]);
+
+        return response()->json(['success' => $user->name.($user->track_attendance ? ' is now tracked in attendance.' : ' is no longer tracked (no absences, not in reports).')]);
+    }
+
+    private function validateType(Request $request, ?LeaveType $type = null): array
+    {
+        $data = $request->validate([
+            'name' => ['required', 'string', 'max:60', Rule::unique('leave_types', 'name')->ignore($type?->id)],
+            'color' => ['required', 'regex:/^#[0-9a-fA-F]{6}$/'],
+            'allowance_source' => ['required', Rule::in(array_keys(LeaveType::SOURCES))],
+            'days_per_year' => 'nullable|required_if:allowance_source,fixed|numeric|min:0|max:365',
+            'carry_forward_max' => 'nullable|numeric|min:0|max:365',
+            'is_paid' => 'boolean',
+            'allow_negative' => 'boolean',
+            'requires_reason' => 'boolean',
+            'is_active' => 'boolean',
+        ]);
+
+        // Annual Leave must stay on the company allowance so the setting keeps working.
+        if ($type && $type->code === 'annual' && $data['allowance_source'] !== 'annual') {
+            abort(response()->json(['message' => 'Annual Leave always uses the company annual allowance.', 'errors' => ['allowance_source' => ['Annual Leave always uses the company annual allowance.']]], 422));
+        }
+
+        return [
+            'name' => $data['name'],
+            'color' => $data['color'],
+            'allowance_source' => $data['allowance_source'],
+            'days_per_year' => $data['allowance_source'] === 'fixed' ? $data['days_per_year'] : null,
+            'carry_forward_max' => $data['allowance_source'] === 'none' ? 0 : (float) ($data['carry_forward_max'] ?? 0),
+            'is_paid' => $request->boolean('is_paid'),
+            'allow_negative' => $request->boolean('allow_negative'),
+            'requires_reason' => $request->boolean('requires_reason'),
+            'is_active' => $request->boolean('is_active'),
+        ];
+    }
+}
