+        $bobs = LeaveRequest::where('user_id', $this->bob->id)->first();
+        $alices = LeaveRequest::where('user_id', $this->alice->id)->first();
+
+        $this->actingAs($this->bob->fresh())->postJson(route('leaves.approve', $bobs))->assertStatus(403);
