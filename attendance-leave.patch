+
+        async function submit(form, url, method, body) {
+            const btn = form.querySelector('[type="submit"]');
+            XA.showErrors(form, {});
+            XA.busy(btn, true);
+            try {
+                const data = await XA.request(url, { method, body });
+                XA.toast('success', data.success);
+                return data;
+            } catch (err) {
+                XA.showErrors(form, err.errors);
+                throw err;
